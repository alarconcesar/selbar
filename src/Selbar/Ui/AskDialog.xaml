<ui:FluentWindow x:Class="Selbar.Ui.AskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Selbar.Ui"
        Title="Selbar · Preguntar a la IA" TitleBarTitle="Selbar · Preguntar a la IA" IsDialog="True"
        Height="430" Width="560" MinHeight="400" MinWidth="420"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Topmost="True">
    <Grid Background="{DynamicResource BgWindow}" Margin="24,14,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoft}"
                    BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
                <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{DynamicResource AccentText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Escribe qué quieres hacer con el texto seleccionado."
                       Style="{StaticResource PageSubtitle}" Margin="10,0,0,0"
                       VerticalAlignment="Center" MaxWidth="440"/>
        </StackPanel>

        <TextBlock x:Name="InstructionLabel" Grid.Row="1" Style="{StaticResource SectionText}"
                   Text="Tu instrucción"/>

        <Grid Grid.Row="2">
            <TextBox x:Name="PromptBox" MinHeight="80" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     SpellCheck.IsEnabled="True" Language="es-ES"
                     PreviewKeyDown="OnPromptKey" TextChanged="OnPromptChanged"
                     AutomationProperties.LabeledBy="{Binding ElementName=InstructionLabel}"
                     ToolTip="Enter pregunta · Mayús+Enter salto de línea"/>
            <TextBlock Text="Ej.: resume esto en 3 puntos, tradúcelo al francés…"
                       Foreground="{DynamicResource TextTertiary}" Margin="12,10,0,0"
                       VerticalAlignment="Top" IsHitTestVisible="False"
                       Visibility="{Binding Text, ElementName=PromptBox, Converter={StaticResource EmptyToVisible}}"/>
        </Grid>

        <TextBlock x:Name="PromptHint" Grid.Row="3" Margin="0,5,0,0" Style="{StaticResource HintText}"
                   Text="Enter pregunta · Mayús+Enter, nueva línea"/>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <DockPanel>
                <Button x:Name="SelectionToggleBtn" DockPanel.Dock="Right" Content="Ver texto completo"
                        Style="{StaticResource SubtleButton}" Height="24" MinHeight="24"
                        Padding="8,0" FontSize="11" Margin="8,0,0,0"
                        Click="OnToggleSelection" Visibility="Collapsed"/>
                <TextBlock x:Name="SelectionSummaryText" Style="{StaticResource SectionText}"
                           Text="Texto seleccionado" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <Border Background="{DynamicResource BgWell}" BorderBrush="{DynamicResource StrokeSubtle}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusS}" Padding="12,8">
                <Grid>
                    <TextBox x:Name="SelectionBox" IsReadOnly="True" Height="52" Background="Transparent"
                             BorderThickness="0" Padding="0" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource TextSecondary}"
                             AutomationProperties.Name="Vista previa del texto seleccionado"/>
                    <TextBox x:Name="SelectionFullBox" IsReadOnly="True" Height="70" Background="Transparent"
                             BorderThickness="0" Padding="0" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource TextSecondary}"
                             Visibility="Collapsed"
                             AutomationProperties.Name="Texto seleccionado completo"/>
                </Grid>
            </Border>
            <TextBlock x:Name="SelectionHint" Style="{StaticResource HintText}" Margin="0,5,0,0"
                       Text="Se envía el texto completo (máx. de caracteres en Ajustes)."/>
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="El resultado se abrirá aparte."
                       Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SubtleButton}" Width="100"
                        IsCancel="True" Click="OnCancel" Margin="0,0,8,0"/>
                <Button x:Name="AskBtn" Content="Preguntar" Style="{StaticResource AccentButton}" Width="120"
                        IsDefault="True" IsEnabled="False" Click="OnOk"
                        ToolTip="Escribe una instrucción para continuar"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
