<ui:FluentWindow x:Class="Selbar.Ui.ColorPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Selbar.Ui"
        Title="Selbar · Color" TitleBarTitle="Selbar · Color" IsDialog="True"
        Height="560" Width="470" MinHeight="520" MinWidth="460"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Damero local para que la transparencia se lea como transparencia, sin imágenes. -->
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile"
                      Viewport="0,0,16,16" ViewportUnits="Absolute"
                      Viewbox="0,0,16,16" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0 H16 V16 H0 Z"/>
                    <GeometryDrawing Brush="#FFE4E4E4" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid Background="{DynamicResource BgWindow}" Margin="24,18,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Color seleccionado" Style="{StaticResource PageSubtitle}"
                       Margin="0,0,0,10"/>

            <!-- La etiqueta vive fuera de la muestra: el contraste no depende del color ni del alfa. -->
            <StackPanel Grid.Row="1">
                <Border x:Name="Swatch" Height="96" CornerRadius="{StaticResource RadiusM}"
                        BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"
                        AutomationProperties.Name="Muestra del color">
                    <Grid>
                        <Border Background="{StaticResource CheckerBrush}" CornerRadius="{StaticResource RadiusM}"/>
                        <Border x:Name="SwatchColor" Background="Transparent" CornerRadius="{StaticResource RadiusM}"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="SwatchText" FontFamily="{StaticResource FontDisplay}" FontSize="22"
                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextPrimary}" Text="—"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource StrokeSubtle}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusM}" Margin="0,14,0,0"
                    Padding="4">
                <StackPanel>
                    <Border Style="{StaticResource CardRow}" Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HexLabel" Text="HEX" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HexText" Grid.Column="1" FontFamily="{StaticResource FontMono}"
                                       FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardRow}" Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RGB" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RgbText" Grid.Column="1" FontFamily="{StaticResource FontMono}"
                                       FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="RgbCopyBtn" Grid.Column="2" Content="&#xE8C8;" Style="{StaticResource IconButton}"
                                    Width="28" Height="28" MinHeight="28" FontFamily="{StaticResource IconFont}"
                                    FontSize="13" Tag="rgb" Click="OnCopyValue" ToolTip="Copiar RGB o RGBA"
                                    AutomationProperties.Name="Copiar RGB o RGBA"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardRow}" Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HSL" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HslText" Grid.Column="1" FontFamily="{StaticResource FontMono}"
                                       FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="HslCopyBtn" Grid.Column="2" Content="&#xE8C8;" Style="{StaticResource IconButton}"
                                    Width="28" Height="28" MinHeight="28" FontFamily="{StaticResource IconFont}"
                                    FontSize="13" Tag="hsl" Click="OnCopyValue" ToolTip="Copiar HSL o HSLA"
                                    AutomationProperties.Name="Copiar HSL o HSLA"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardRow}" BorderThickness="0" Padding="12,9"
                            x:Name="AlphaRow">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Alfa" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AlphaText" Grid.Column="1" FontFamily="{StaticResource FontMono}"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" Grid.Row="0"
                           TextWrapping="Wrap"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="MoreBtn" Style="{StaticResource IconButton}" Content="&#xE712;"
                            Margin="0,0,6,0" ToolTip="Más formatos"
                            AutomationProperties.Name="Más formatos de color" Click="OnMore">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="CopyHexNoAlphaMenuItem"
                                          Header="Copiar HEX sin alfa" Click="OnCopyHexNoAlpha"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="CopyHexBtn" Content="Copiar HEX" Style="{StaticResource AccentButton}"
                            MinWidth="130" Click="OnCopyHex"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:FluentWindow>
