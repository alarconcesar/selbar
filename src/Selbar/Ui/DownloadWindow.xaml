<ui:FluentWindow x:Class="Selbar.Ui.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Selbar.Ui"
        Title="Descargar" TitleBarTitle="Descargar" IsDialog="True"
        Height="470" Width="600" MinHeight="430" MinWidth="520"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid Background="{DynamicResource BgWindow}" Margin="24,18,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="{StaticResource RadiusM}"
                        Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                        BorderThickness="1">
                    <TextBlock x:Name="HeaderIcon" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="17"
                               Foreground="{DynamicResource AccentText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DownloadTitle" Text="Descargar" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="UrlText" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="ProgressHost" Grid.Row="1">
                <ProgressBar x:Name="Bar" Height="4" Minimum="0" Maximum="100" Value="0">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track">
                                <Border Background="{DynamicResource BgSegmentTrack}" CornerRadius="2"/>
                                <Border x:Name="PART_Indicator" Background="{DynamicResource AccentFill}"
                                        CornerRadius="2" HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <TextBlock x:Name="StatusText" Text="Preparando…" FontSize="13" Margin="0,10,0,0"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="DetailText" Style="{StaticResource HintText}" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border x:Name="MissingPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,14,0,0"
                    Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource StrokeSubtle}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusM}" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Falta yt-dlp" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="Selbar descarga con yt-dlp, una herramienta externa. Instálala desde la release oficial de GitHub y continúa; también puedes instalarla tú y volver a intentarlo."/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="InstallBtn" Content="Instalar yt-dlp y continuar"
                                Style="{StaticResource AccentButton}" Click="OnInstall" Margin="0,0,8,0"/>
                        <Button x:Name="OpenYtDlpPageBtn" Content="Abrir página de yt-dlp"
                                Style="{StaticResource SubtleButton}" Click="OnOpenYtDlpPage"/>
                    </StackPanel>
                    <TextBlock x:Name="InstallStatus" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Diagnóstico, compatibilidad y aviso legal solo bajo demanda. -->
            <Expander x:Name="DetailsExpander" Grid.Row="3" Header="Detalles técnicos"
                      IsExpanded="False" VerticalAlignment="Top" Margin="0,10,0,0">
                <StackPanel>
                    <Border x:Name="LogPanel" Height="110" Background="{DynamicResource BgWell}"
                            BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusS}" Padding="10,8">
                        <TextBox x:Name="LogText" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextTertiary}" FontFamily="{StaticResource FontMono}"
                                 FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                    <TextBlock x:Name="Footnote" Style="{StaticResource CaptionText}" Margin="0,8,0,8"
                               TextWrapping="Wrap"
                               Text="Solo se descarga el vídeo o el audio que has seleccionado. Respeta los derechos de autor y las condiciones de cada plataforma."/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SitesBtn" Content="Sitios compatibles" Style="{StaticResource SubtleButton}"
                                Click="OnSupportedSites"/>
                        <Button x:Name="ToolPageBtn" Content="Página de yt-dlp" Style="{StaticResource SubtleButton}"
                                Margin="6,0,0,0" Click="OnOpenYtDlpPage"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenFolderBtn" Content="Abrir carpeta" Style="{StaticResource SubtleButton}"
                        IsEnabled="False" Click="OnOpenFolder" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RetryBtn" Content="Reintentar" Style="{StaticResource AccentButton}"
                            Margin="0,0,8,0" Visibility="Collapsed" Click="OnRetry"/>
                    <Button x:Name="CloseActionBtn" Content="Cancelar" Style="{StaticResource SubtleButton}"
                            MinWidth="100" Click="OnCloseAction"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:FluentWindow>
