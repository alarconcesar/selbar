<ui:FluentWindow x:Class="Selbar.Ui.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Selbar.Ui"
        Title="Selbar · Historial"
        TitleBarTitle="Selbar" Height="660" Width="1000"
        MinHeight="480" MinWidth="780">
    <Grid Background="{DynamicResource BgWindow}" Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera: título, alcance real y menú de gestión. -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Historial"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}"
                           Text="Resultados guardados en este equipo."/>
            </StackPanel>
            <Button x:Name="ManageBtn" Grid.Column="1" Style="{StaticResource IconButton}"
                    Content="&#xE712;" ToolTip="Opciones del historial"
                    AutomationProperties.Name="Opciones del historial"
                    VerticalAlignment="Top" Click="OnManage">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Ajustes de historial y privacidad" Click="OnOpenHistorySettings"/>
                        <Separator/>
                        <MenuItem x:Name="ClearMenuItem" Header="Limpiar todo el historial" Click="OnClear"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <!-- Lista + vista previa. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- La búsqueda vive sobre la lista, no en una columna fija del encabezado. -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBox x:Name="FilterBox" TextChanged="OnFilter" PreviewKeyDown="OnFilterKeyDown" Padding="32,6,10,6"
                             ToolTip="Filtrar por acción, modelo o texto"
                             AutomationProperties.Name="Buscar en el historial"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Foreground="{DynamicResource TextTertiary}" Margin="11,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="Buscar en el historial…" Foreground="{DynamicResource TextTertiary}"
                               Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource EmptyToVisible}}"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource StrokeSubtle}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusM}" Padding="4">
                        <ListBox x:Name="EntryList" SelectionChanged="OnSelect" MouseDoubleClick="OnDoubleClick"
                                 AutomationProperties.Name="Resultados guardados">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="32" Height="32" CornerRadius="{StaticResource RadiusS}" Background="{DynamicResource BgBadge}"
                                                BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1">
                                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Foreground="{DynamicResource TextSecondary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Action}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding WhenRelative}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextTertiary}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Preview}" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                   Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyText" Text="Aún no hay resultados de IA."
                                   Foreground="{DynamicResource TextTertiary}" FontSize="12.5"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" TextAlignment="Center"
                                   MaxWidth="250" TextWrapping="Wrap"/>
                        <Button x:Name="ClearFilterBtn" Content="Quitar filtro" Style="{StaticResource SubtleButton}"
                                Margin="0,10,0,0" HorizontalAlignment="Center" Visibility="Collapsed"
                                Click="OnClearFilter"/>
                        <Button x:Name="HistorySettingsBtn" Content="Abrir ajustes de historial"
                                Style="{StaticResource SubtleButton}" Margin="0,10,0,0"
                                HorizontalAlignment="Center" Visibility="Collapsed"
                                Click="OnOpenHistorySettings"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusM}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="PreviewTitle" Text="Nada seleccionado" FontSize="14"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PreviewMeta" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Copiar resultado" Style="{StaticResource AccentButton}"
                                        Margin="0,0,6,0" Click="OnCopy" IsEnabled="False" x:Name="CopyBtn"/>
                                <Button Content="Abrir" Style="{StaticResource SubtleButton}"
                                        Margin="0,0,4,0" Click="OnOpen" IsEnabled="False" x:Name="OpenBtn"
                                        ToolTip="Abrir con formato en una ventana de resultado"/>
                                <Button x:Name="MoreBtn" Style="{StaticResource IconButton}" Content="&#xE712;"
                                        ToolTip="Más opciones de la entrada"
                                        AutomationProperties.Name="Más opciones de la entrada"
                                        Click="OnMore">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="ShowOriginalMenuItem"
                                                      Header="Ver original y datos completos"
                                                      Click="OnShowOriginal"/>
                                            <MenuItem x:Name="RepeatMenuItem"
                                                      Header="Repetir con el texto original (nueva petición)"
                                                      Click="OnRepeat"/>
                                            <Separator/>
                                            <MenuItem x:Name="DeleteMenuItem" Header="Eliminar entrada"
                                                      Click="OnDelete"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <FlowDocumentScrollViewer x:Name="PreviewView" VerticalScrollBarVisibility="Auto"
                                                  Background="Transparent" Padding="16,12,8,12"
                                                  IsToolBarVisible="False"/>
                        <TextBlock x:Name="PreviewPlaceholder" Text="Selecciona un resultado para verlo aquí."
                                   Foreground="{DynamicResource TextTertiary}" FontSize="12.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Original y metadatos completos solo bajo demanda. -->
                    <Border x:Name="OriginalPanel" Grid.Row="2" Visibility="Collapsed"
                            BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="0,1,0,0"
                            Background="{DynamicResource BgWell}" Padding="16,10">
                        <StackPanel>
                            <TextBlock Text="Texto original y datos completos" Style="{StaticResource SectionText}"/>
                            <TextBox x:Name="OriginalText" IsReadOnly="True" TextWrapping="Wrap"
                                     MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     FontSize="12"/>
                            <TextBlock x:Name="OriginalMeta" Style="{StaticResource CaptionText}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Repetir usa la acción y la configuración actuales; el modelo puede haber cambiado desde que se guardó."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Pie: solo estado y conteo real. Las acciones destructivas viven en los menús. -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="CountText" Grid.Column="1" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
