<ui:FluentWindow x:Class="Selbar.Ui.PromptLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Selbar.Ui"
        Title="Selbar · Biblioteca de prompts"
        TitleBarTitle="Selbar" Height="680" Width="920"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="{DynamicResource BgWindow}" Margin="28,20,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="Biblioteca de prompts"/>
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="Recetas listas para usar. Se añaden al borrador de Ajustes y puedes editarlas después."/>
        </StackPanel>

        <!-- Búsqueda y grupo -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <TextBox x:Name="FilterBox" TextChanged="OnFilter" Padding="32,6,10,6"
                         AutomationProperties.Name="Buscar recetas"
                         ToolTip="Filtrar por nombre, grupo o descripción"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           Foreground="{DynamicResource TextTertiary}" Margin="11,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock Text="Buscar receta…" Foreground="{DynamicResource TextTertiary}"
                           Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource EmptyToVisible}}"/>
            </Grid>
            <ComboBox x:Name="GroupFilter" Grid.Column="1" Width="180"
                      SelectionChanged="OnGroupFilter" AutomationProperties.Name="Filtrar por grupo"/>
        </Grid>

        <TextBlock x:Name="CountText" Grid.Row="2" Style="{StaticResource CaptionText}" Margin="2,8,0,8"/>

        <!-- Lista + detalle -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource StrokeSubtle}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusM}" Padding="4">
                <Grid>
                    <ListBox x:Name="RecipeList" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnRecipeSelected"
                             AutomationProperties.Name="Recetas disponibles">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Recipe.Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Recipe.Description}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource BgBadge}"
                                            BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusS}" Padding="6,2" VerticalAlignment="Center"
                                            Visibility="{Binding HasState, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="{Binding StateLabel}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyHint" Text="Ninguna receta coincide con la búsqueda."
                               Foreground="{DynamicResource TextTertiary}" FontSize="12.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Detalle: qué se añade y qué hará -->
            <Border Grid.Column="2" Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusM}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DetailEmpty" Text="Selecciona una receta para leer el prompt completo y el efecto de su resultado."
                               Foreground="{DynamicResource TextTertiary}" FontSize="12.5" TextWrapping="Wrap"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>

                    <ScrollViewer x:Name="DetailBody" Grid.Row="0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="{StaticResource RadiusS}"
                                    Padding="6,2" Margin="0,6,0,0" HorizontalAlignment="Left">
                                <TextBlock x:Name="DetailGroup" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentText}"/>
                            </Border>
                            <TextBlock x:Name="DetailDescription" Style="{StaticResource HintText}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>

                            <TextBlock Style="{StaticResource SectionText}" Text="Resultado" Margin="0,14,0,4"/>
                            <TextBlock x:Name="DetailOutput" FontSize="12.5" TextWrapping="Wrap"/>

                            <TextBlock Style="{StaticResource SectionText}" Text="Prompt completo" Margin="0,14,0,6"/>
                            <TextBox x:Name="PromptPreviewBox" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="150"
                                     FontFamily="{StaticResource FontMono}" FontSize="12"
                                     AutomationProperties.Name="Prompt completo de la receta"/>

                            <TextBlock x:Name="DetailState" Style="{StaticResource HintText}" Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Button x:Name="AddButton" Grid.Row="1" Content="Añadir a mis acciones"
                            Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch"
                            Margin="0,12,0,0" Click="OnAdd"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Pie -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" FontSize="11.5"
                       Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" Margin="0,0,16,0"/>
            <Button Grid.Column="1" Content="Cerrar" Style="{StaticResource SubtleButton}" Width="110"
                    Click="OnClose"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
