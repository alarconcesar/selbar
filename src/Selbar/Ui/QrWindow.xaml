<ui:FluentWindow x:Class="Selbar.Ui.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Selbar.Ui"
        Title="Selbar · Código QR" TitleBarTitle="Selbar · Código QR" IsDialog="True"
        Height="560" Width="460" MinHeight="480" MinWidth="360"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource BgWindow}" Margin="24,18,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Código QR del enlace" Style="{StaticResource PageSubtitle}"/>
            <TextBlock x:Name="LinkText" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis"
                       Margin="0,4,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </StackPanel>

        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 MaxWidth="380" MaxHeight="380">
            <Border x:Name="QrFrame" Background="White" CornerRadius="{StaticResource RadiusM}"
                    BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1" Padding="10"
                    AutomationProperties.Name="Código QR del enlace">
                <Image x:Name="QrImage" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
        </Viewbox>

        <StackPanel x:Name="ErrorPanel" Grid.Row="1" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="330">
            <TextBlock Text="&#xEA39;" FontFamily="{StaticResource IconFont}" FontSize="28"
                       Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="QrErrorText" Foreground="{DynamicResource TextSecondary}" FontSize="12.5"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource CaptionText}"
                   HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"
                   TextAlignment="Center" MaxWidth="360"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button x:Name="CopyImageBtn" Content="Copiar imagen" Style="{StaticResource AccentButton}"
                    MinWidth="140" Click="OnCopyImage"/>
            <Button x:Name="SavePngBtn" Content="Guardar PNG" Style="{StaticResource SubtleButton}"
                    MinWidth="130" Margin="8,0,0,0" Click="OnSavePng"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
