<ui:FluentWindow x:Class="Selbar.Ui.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Selbar.Ui"
        Title="Selbar" TitleBarTitle="Selbar" ShowTitleBar="False"
        Height="470" Width="600" MinHeight="300" MinWidth="400" Topmost="True"
        WindowStartupLocation="Manual">
    <Grid Background="{DynamicResource BgWindow}">
        <Grid Margin="16,10,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecera (también sirve para arrastrar la ventana) -->
            <DockPanel Grid.Row="0" ui:Chrome.IsDragHandle="True" Background="Transparent">
                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Width="32" Height="32"
                        Style="{StaticResource IconButton}" Click="OnClose" ToolTip="Cerrar (Esc)"
                        FontFamily="{StaticResource IconFont}" FontSize="10" Padding="0"
                        Content="&#xE8BB;" AutomationProperties.Name="Cerrar"/>
                <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="8" Height="8"
                         Fill="{DynamicResource AccentText}" Margin="0,7,10,0" VerticalAlignment="Top"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleBlock" FontFamily="{StaticResource FontDisplay}"
                               FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextTertiary}"
                               Text="Listo" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <!-- Progreso y aviso de error: una sola banda, nunca permanente -->
            <StackPanel Grid.Row="1">
                <Border x:Name="StreamTrack" Height="2" CornerRadius="1"
                        Background="{DynamicResource StrokeSubtle}" ClipToBounds="True" Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <Border x:Name="StreamBar" Width="130" Height="2" CornerRadius="1"
                            Background="{DynamicResource AccentFill}" HorizontalAlignment="Left">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="StreamShift" X="-130"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>

                <Border x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,8"
                        Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerStroke}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusS}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Top">
                                <Button x:Name="ErrorCopyBtn" Content="Copiar detalles"
                                        Style="{StaticResource SubtleButton}" Height="24" MinHeight="24"
                                        Padding="8,0" FontSize="11" Margin="0,0,4,0"
                                        Click="OnCopyErrorDetails"
                                        ToolTip="Copia el mensaje técnico completo"/>
                                <Button x:Name="ErrorDetailsBtn" Content="Detalles"
                                        Style="{StaticResource SubtleButton}" Height="24" MinHeight="24"
                                        Padding="8,0" FontSize="11" Click="OnToggleErrorDetails"
                                        ToolTip="Muestra el mensaje técnico completo"/>
                            </StackPanel>
                            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource Danger}" VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                        </DockPanel>
                        <TextBlock x:Name="ErrorHint" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextTertiary}" Margin="0,4,0,0"
                                   Visibility="Collapsed"
                                   Text="El texto parcial se conserva: puedes copiarlo desde Más."/>
                        <Border x:Name="ErrorDetailsPanel" Visibility="Collapsed" Margin="0,6,0,0">
                            <TextBox x:Name="ErrorDetailsBox" IsReadOnly="True" TextWrapping="Wrap"
                                     MaxHeight="96" VerticalScrollBarVisibility="Auto" FontSize="11"
                                     VerticalContentAlignment="Top"
                                     Background="Transparent" BorderThickness="0" Padding="0"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Barra única: Editar + Ajustar (menú con los seis ajustes) y solo lo necesario -->
            <Grid Grid.Row="2" Margin="0,10,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="EditToggleBtn" Height="30" MinHeight="30" Padding="10,0"
                            Click="OnToggleEdit" ToolTip="Edita el texto antes de copiar o reemplazar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="EditIcon" Text="&#xE70F;" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="EditLabel" Text="Editar" Margin="6,0,0,0" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel x:Name="RefinePanel" Orientation="Horizontal" Visibility="Collapsed"
                                Margin="4,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="RefineMenuBtn" Content="Ajustar texto"
                                Style="{StaticResource SubtleButton}" Height="30" MinHeight="30"
                                Padding="8,0" FontSize="12" Click="OnRefineMenu"
                                ToolTip="Ajusta el texto que estás viendo; se guarda como versión nueva"
                                AutomationProperties.Name="Ajustar texto">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="RefineMenu">
                                    <MenuItem Header="Más corto" Click="OnRefine"
                                              Tag="Hazlo más breve sin perder información. Devuelve solo el resultado."/>
                                    <MenuItem Header="Más formal" Click="OnRefine"
                                              Tag="Reescríbelo con un tono más formal y profesional. Devuelve solo el resultado."/>
                                    <MenuItem Header="Más claro" Click="OnRefine"
                                              Tag="Hazlo más claro y fácil de leer. Devuelve solo el resultado."/>
                                    <MenuItem Header="En viñetas" Click="OnRefine"
                                              Tag="Conviértelo en una lista de viñetas. Devuelve solo la lista."/>
                                    <MenuItem Header="Explicar" Click="OnRefine"
                                              Tag="Explícalo de forma sencilla, como a un principiante. Devuelve solo la explicación."/>
                                    <MenuItem Header="Traducir" Click="OnRefine"
                                              Tag="Traduce el texto al {lang}. Devuelve solo la traducción."/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="DiffBtn" Content="Ver cambios" Style="{StaticResource SubtleButton}"
                            Height="28" MinHeight="28" Padding="8,0" FontSize="11" Margin="0,0,6,0"
                            Visibility="Collapsed" Click="OnToggleDiff"
                            ToolTip="Compara el original con el resultado"/>
                    <StackPanel x:Name="VersionNav" Orientation="Horizontal" Visibility="Collapsed"
                                VerticalAlignment="Center">
                        <Button x:Name="VersionPrev" Content="&#xE76B;" Style="{StaticResource IconButton}"
                                FontFamily="{StaticResource IconFont}" FontSize="10" Width="28" Height="28"
                                MinHeight="28" Click="OnPrevVersion" ToolTip="Versión anterior"
                                AutomationProperties.Name="Versión anterior"/>
                        <TextBlock x:Name="VersionLabel" Text="1/1" FontSize="12"
                                   Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                                   Margin="3,0" MinWidth="26" TextAlignment="Center"/>
                        <Button x:Name="VersionNext" Content="&#xE76C;" Style="{StaticResource IconButton}"
                                FontFamily="{StaticResource IconFont}" FontSize="10" Width="28" Height="28"
                                MinHeight="28" Click="OnNextVersion" ToolTip="Versión siguiente"
                                AutomationProperties.Name="Versión siguiente"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Contenido: la lectura ocupa todo el alto que sobre -->
            <Border x:Name="ContentCard" Grid.Row="3" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource StrokeSubtle}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusM}" ClipToBounds="True">
                <Grid>
                    <FlowDocumentScrollViewer x:Name="ViewPane" VerticalScrollBarVisibility="Auto"
                                              Background="Transparent" Padding="16,12,8,12"
                                              ToolTip="Ctrl + / Ctrl − / Ctrl 0 para zoom">
                        <FlowDocumentScrollViewer.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ViewCopyMenuItem" Header="Copiar todo" Click="OnCopy"/>
                                <Separator/>
                                <MenuItem x:Name="ViewSaveMenuItem" Header="Guardar como…" InputGestureText="Ctrl+S" Click="OnSaveFile"/>
                                <MenuItem x:Name="ViewReplaceMenuItem" Header="Reemplazar la selección"
                                          InputGestureText="Ctrl+Enter" Click="OnReplace"/>
                            </ContextMenu>
                        </FlowDocumentScrollViewer.ContextMenu>
                    </FlowDocumentScrollViewer>
                    <TextBox x:Name="Body" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" FontSize="14" Visibility="Collapsed"
                             Background="Transparent" BorderThickness="0" Padding="16,10,10,10"
                             SpellCheck.IsEnabled="True" Language="es-ES"
                             ToolTip="Ctrl + / Ctrl − / Ctrl 0 para zoom">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Cortar" Command="ApplicationCommands.Cut"/>
                                <MenuItem Header="Copiar" Command="ApplicationCommands.Copy"/>
                                <MenuItem Header="Pegar" Command="ApplicationCommands.Paste"/>
                                <MenuItem Header="Seleccionar todo" Command="ApplicationCommands.SelectAll"/>
                                <Separator/>
                                <MenuItem Header="Guardar como…" InputGestureText="Ctrl+S" Click="OnSaveFile"/>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Seguimiento: compacto y secundario; nunca roba el foco al terminar -->
            <Border x:Name="ChatRow" Grid.Row="4" Visibility="Collapsed" Margin="0,10,0,0"
                    Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource Stroke}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusS}" Padding="8,3,4,3">
                <DockPanel>
                    <Button x:Name="ChatSendBtn" DockPanel.Dock="Right" Content="Enviar"
                            Style="{StaticResource SubtleButton}" Height="28" MinHeight="28"
                            Padding="14,0" Margin="8,0,0,0" Click="OnChatSend"
                            ToolTip="Pregunta de seguimiento"/>
                    <Grid>
                        <TextBox x:Name="ChatBox" KeyDown="OnChatKey"
                                 Background="Transparent" BorderThickness="0" MinHeight="28" MaxHeight="88"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="6,4" VerticalContentAlignment="Top"
                                 SpellCheck.IsEnabled="True" Language="es-ES"
                                 AutomationProperties.Name="Pregunta de seguimiento"
                                 ToolTip="Enter envía · Mayús+Enter salto de línea"/>
                        <TextBlock x:Name="ChatPlaceholder" Text="Pregunta de seguimiento…"
                                   Foreground="{DynamicResource TextTertiary}" Margin="12,5,0,0"
                                   VerticalAlignment="Top" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=ChatBox, Converter={StaticResource EmptyToVisible}}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Pie: una sola acción acentuada; en 400 DIP las secundarias refluyen -->
            <WrapPanel x:Name="FooterPanel" Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="StopBtn" Content="Detener" Style="{StaticResource AccentButton}"
                        Height="32" MinHeight="32" Padding="12,0" Margin="0,0,6,0" Click="OnStop"
                        ToolTip="Detener la generación" Visibility="Collapsed"/>
                <Button x:Name="RetryBtn" Content="Reintentar" Style="{StaticResource SubtleButton}"
                        Height="32" MinHeight="32" Padding="12,0" Margin="0,0,6,0" Click="OnRetry"
                        ToolTip="Genera una versión nueva con la misma petición (Ctrl+R)"
                        Visibility="Collapsed"/>
                <Button x:Name="ErrorSettingsBtn" Content="Abrir ajustes de IA"
                        Style="{StaticResource SubtleButton}" Height="32" MinHeight="32" Padding="12,0"
                        Margin="0,0,6,0" Click="OnOpenAiSettings" Visibility="Collapsed"
                        ToolTip="Revisa el proveedor, el modelo y la API key"/>
                <Button x:Name="CopyBtn" Content="Copiar" Style="{StaticResource SubtleButton}"
                        Height="32" MinHeight="32" Padding="12,0" Margin="0,0,6,0" Click="OnCopy"
                        ToolTip="Copiar como texto, sin markdown (Enter)"/>
                <Button x:Name="ReplaceBtn" Content="Reemplazar" Style="{StaticResource AccentButton}"
                        Height="32" MinHeight="32" Padding="14,0" Margin="0,0,6,0" Click="OnReplace"
                        ToolTip="Pegar el resultado sobre la selección (Ctrl+Enter)"/>
                <Button x:Name="MoreBtn" Style="{StaticResource IconButton}" Width="32" Height="32"
                        Content="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="15"
                        Click="OnMore" ToolTip="Más opciones" AutomationProperties.Name="Más opciones">
                    <Button.ContextMenu>
                        <ContextMenu ContextMenuOpening="OnMoreMenuOpening">
                            <MenuItem x:Name="MoreCopyMarkdownItem" Header="Copiar como Markdown" Click="OnCopyMarkdown"
                                      ToolTip="Copia el texto con sus marcas (**negrita**, listas, enlaces)"/>
                            <MenuItem x:Name="MoreSaveItem" Header="Guardar como…" InputGestureText="Ctrl+S" Click="OnSaveFile"/>
                            <MenuItem x:Name="MoreReuseItem" Header="Usar como selección" Click="OnReuseAsSelection"
                                      ToolTip="Cierra esto y abre la barra con el resultado como texto"/>
                            <MenuItem x:Name="MoreCopyPartialItem" Header="Copiar texto parcial" Click="OnCopyPartial"
                                      Visibility="Collapsed"
                                      ToolTip="Copia solo el texto recibido antes del error"/>
                            <Separator x:Name="MoreAiSeparator"/>
                            <MenuItem x:Name="MoreAiSettingsItem" Header="Ajustes de IA" Click="OnOpenAiSettings"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
