<ui:FluentWindow x:Class="Selbar.Ui.TextStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Selbar.Ui"
        Title="Selbar · Estilos de letra" TitleBarTitle="Selbar"
        Height="620" Width="640" MinHeight="420" MinWidth="520"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource BgWindow}" Margin="28,20,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Estilos de letra" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Elige un estilo Unicode y copia el texto completo."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusM}" Padding="4">
            <Grid>
                <ListBox x:Name="StyleList" SelectionChanged="OnSelectStyle"
                         MouseDoubleClick="OnStyleDoubleClick"
                         AutomationProperties.Name="Estilos Unicode disponibles">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardRow}" Padding="12,10" BorderThickness="0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Preview}" FontSize="15" TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsHitTestVisible="False" Visibility="Collapsed">
                    <TextBlock Text="&#xE8D2;" FontFamily="{StaticResource IconFont}" FontSize="28"
                               Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Selecciona texto para ver estilos."
                               Foreground="{DynamicResource TextTertiary}" FontSize="12.5"
                               HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"
                               MaxWidth="260" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Estado y alcance en columnas reales; una sola primaria copia el estilo elegido. -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                <TextBlock x:Name="ScopeText" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                           Margin="0,2,0,0" Text="Se copia el texto completo, no solo la vista previa."
                           ToolTip="No instala fuentes: los glifos dependen de la app donde los pegues. Se transforman letras y números; algunos estilos también cambian signos y espacios. Tildes, ñ y emojis se mantienen."/>
            </StackPanel>
            <Button x:Name="CopyStyleBtn" Grid.Column="1" Content="Copiar estilo"
                    Style="{StaticResource AccentButton}" MinWidth="150" IsEnabled="False"
                    Click="OnCopyStyle"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
