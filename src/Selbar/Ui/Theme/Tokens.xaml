<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="clr-namespace:Selbar.Ui">

    <!-- ============================================================
         TOKENS · tipografía (escala Fluent 2)
         ============================================================ -->
    <FontFamily x:Key="FontText">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <!-- Clave heredada (versiones anteriores) -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">20</sys:Double>
    <sys:Double x:Key="FontSizeTitle">28</sys:Double>

    <!-- ============================================================
         TOKENS · superficies (paleta Fluent, mutada por Theming)
         Los valores de aquí son el tema oscuro inicial; Theming.Apply
         cambia el color de cada pincel al arrancar y al cambiar de tema.
         ============================================================ -->
    <SolidColorBrush x:Key="BgWindow" Color="#FF202020"/>
    <SolidColorBrush x:Key="BgLayer" Color="#FF272727"/>
    <SolidColorBrush x:Key="BgCard" Color="#FF2D2D2D"/>
    <SolidColorBrush x:Key="BgCardHover" Color="#FF323232"/>
    <SolidColorBrush x:Key="BgInput" Color="#FF2D2D2D"/>
    <SolidColorBrush x:Key="BgInputHover" Color="#FF333333"/>
    <SolidColorBrush x:Key="BgControl" Color="#FF2D2D2D"/>
    <SolidColorBrush x:Key="BgControlHover" Color="#FF333333"/>
    <SolidColorBrush x:Key="BgControlPressed" Color="#FF262626"/>
    <SolidColorBrush x:Key="BgSubtleHover" Color="#FF2E2E2E"/>
    <SolidColorBrush x:Key="BgSubtlePressed" Color="#FF262626"/>
    <SolidColorBrush x:Key="BgSelected" Color="#FF353535"/>
    <SolidColorBrush x:Key="BgOverlay" Color="#F5202020"/>
    <SolidColorBrush x:Key="BgTooltip" Color="#FF2C2C2C"/>
    <SolidColorBrush x:Key="BgFlyout" Color="#FF2C2C2C"/>
    <SolidColorBrush x:Key="BgSegmentTrack" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="BgSegmentThumb" Color="#FF3C3C3C"/>
    <SolidColorBrush x:Key="BgWell" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="BgBadge" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="BgTitleBar" Color="#FF202020"/>

    <SolidColorBrush x:Key="Stroke" Color="#FF3D3D3D"/>
    <SolidColorBrush x:Key="StrokeStrong" Color="#FF4D4D4D"/>
    <SolidColorBrush x:Key="StrokeSubtle" Color="#FF323232"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FFC7C7C7"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#FF9C9C9C"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#FF6E6E6E"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="Success" Color="#FF6CCB5F"/>
    <SolidColorBrush x:Key="Warning" Color="#FFF2C14E"/>
    <SolidColorBrush x:Key="Danger" Color="#FFFF99A4"/>
    <SolidColorBrush x:Key="DangerFill" Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FF3A2020"/>
    <SolidColorBrush x:Key="DangerStroke" Color="#FF6E3030"/>

    <SolidColorBrush x:Key="CheckFill" Color="#FF2D2D2D"/>
    <SolidColorBrush x:Key="CheckStroke" Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="ToggleOffFill" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="ToggleOffStroke" Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="ToggleThumbOff" Color="#FFC8C8C8"/>
    <SolidColorBrush x:Key="ToggleThumbOn" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#FF4F4F4F"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#FF6E6E6E"/>
    <SolidColorBrush x:Key="ScrollThumbPressed" Color="#FF8A8A8A"/>

    <SolidColorBrush x:Key="CaptionHover" Color="#FF383838"/>
    <SolidColorBrush x:Key="CaptionPressed" Color="#FF2C2C2C"/>
    <SolidColorBrush x:Key="CaptionCloseHover" Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="CaptionClosePressed" Color="#FFB12A1F"/>
    <SolidColorBrush x:Key="CaptionGlyph" Color="#FFEDEDED"/>

    <!-- Acento: Theming.Apply cambia estos colores al arrancar con el del sistema -->
    <SolidColorBrush x:Key="AccentFill" Color="#FF0078D4"/>
    <SolidColorBrush x:Key="AccentFillHover" Color="#FF1A86D9"/>
    <SolidColorBrush x:Key="AccentFillPressed" Color="#FF005A9E"/>
    <SolidColorBrush x:Key="AccentText" Color="#FF60CDFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2E60CDFF"/>
    <SolidColorBrush x:Key="AccentBorder" Color="#7060CDFF"/>
    <SolidColorBrush x:Key="AccentSelection" Color="#5560CDFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF60CDFF"/>

    <!-- ============================================================
         TOKENS · formas y espaciado
         ============================================================ -->
    <CornerRadius x:Key="RadiusXs">2</CornerRadius>
    <CornerRadius x:Key="RadiusS">4</CornerRadius>
    <CornerRadius x:Key="RadiusM">8</CornerRadius>
    <CornerRadius x:Key="RadiusL">12</CornerRadius>
    <CornerRadius x:Key="RadiusXl">16</CornerRadius>

    <Thickness x:Key="PadXs">4</Thickness>
    <Thickness x:Key="PadS">8</Thickness>
    <Thickness x:Key="PadM">12</Thickness>
    <Thickness x:Key="PadL">16</Thickness>
    <Thickness x:Key="PadXl">24</Thickness>

    <Thickness x:Key="CardPadding">16</Thickness>

    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="TitleBarHeight">44</sys:Double>
    <sys:Double x:Key="NavWidth">260</sys:Double>

    <!-- ============================================================
         CONVERSORES
         ============================================================ -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <ui:BoolVisibilityConverter x:Key="BoolVisibility"/>
    <ui:InverseBoolConverter x:Key="InverseBool"/>
    <ui:OutputModeBrushConverter x:Key="OutputBadgeBrush"/>
    <ui:EmptyStringToVisibilityConverter x:Key="EmptyToVisible"/>
    <ui:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisible"/>

</ResourceDictionary>
