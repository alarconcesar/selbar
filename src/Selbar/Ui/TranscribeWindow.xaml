<ui:FluentWindow x:Class="Selbar.Ui.TranscribeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Selbar.Ui"
        Title="Selbar · Transcribir audio" TitleBarTitle="Selbar · Transcribir audio" IsDialog="True"
        Height="440" Width="620" MinHeight="400" MinWidth="560"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid Background="{DynamicResource BgWindow}" Margin="24,18,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="{StaticResource RadiusM}"
                        Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                        BorderThickness="1">
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="17"
                               Foreground="{DynamicResource AccentText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Audio a texto con Whisper" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Transcripción con Groq. El audio se envía solo cuando pulsas Transcribir."
                               Style="{StaticResource HintText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="FileText" Text="Ningún audio seleccionado" FontSize="13"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="FileHint" Style="{StaticResource HintText}" Margin="0,2,0,0"
                                   Text="mp3, m4a, wav, ogg, webm, flac, mp4, aac, mpeg o mpga · máximo 25 MB"/>
                    </StackPanel>
                    <Button x:Name="PickFileBtn" Grid.Column="2" Content="Elegir audio…"
                            Style="{StaticResource SubtleButton}" Click="OnPickFile"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- La tarjeta de clave solo aparece si falta; con clave basta una línea de metadatos. -->
            <Border x:Name="KeyPanel" Grid.Row="2" Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusM}" Padding="14,12" Margin="0,0,0,10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Falta la API key de Groq" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="KeyStatus" Style="{StaticResource HintText}" Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="OpenIaBtn" Grid.Column="1" Content="Abrir ajustes de IA"
                            Style="{StaticResource SubtleButton}" Click="OnOpenSettings"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TextBlock x:Name="KeySummary" Grid.Row="2" Style="{StaticResource CaptionText}"
                       Margin="2,0,0,6" Visibility="Collapsed" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="3" Margin="0,2,0,0">
                <Border x:Name="BusyTrack" Height="2" Background="{DynamicResource StrokeSubtle}"
                        CornerRadius="1" ClipToBounds="True" Visibility="Collapsed">
                    <Border x:Name="BusyBar" Width="120" Height="2" Background="{DynamicResource AccentFill}"
                            CornerRadius="1" HorizontalAlignment="Left">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BusyShift" X="-120"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="5" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MoreBtn" Grid.Column="0" Style="{StaticResource IconButton}" Content="&#xE712;"
                        HorizontalAlignment="Left" ToolTip="Más opciones"
                        AutomationProperties.Name="Más opciones de transcripción" Click="OnMore">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Abrir ajustes de IA" Click="OnOpenSettings"/>
                            <MenuItem Header="Formatos y límite" Click="OnShowFormats"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CloseBtn" Content="Cerrar" Style="{StaticResource SubtleButton}"
                            MinWidth="100" Click="OnClose" Margin="0,0,8,0"/>
                    <Button x:Name="TranscribeBtn" Content="Transcribir" Style="{StaticResource AccentButton}"
                            MinWidth="130" Click="OnTranscribe"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:FluentWindow>
